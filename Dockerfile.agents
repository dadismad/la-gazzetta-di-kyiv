# Dockerfile.agents — Gazzetta di Kyiv CCO + CDO Agents
# Build: gcloud builds submit --tag europe-west1-docker.pkg.dev/PROJECT/gazzetta-docker/gazzetta-agents:latest -f Dockerfile.agents .
#
# Separate from the main pipeline Dockerfile — agents need Playwright + browser
# for CDO audits, which adds ~300MB to the image. Pipeline stays lean.

FROM python:3.11-slim

WORKDIR /app

# Install system deps for Playwright + Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps
RUN pip install --no-cache-dir \
    google-cloud-storage \
    google-cloud-secret-manager \
    playwright

# Install Chromium browser for Playwright
RUN playwright install chromium
RUN playwright install-deps chromium

# Copy agent scripts
COPY scripts/cco_curate.py /app/scripts/
COPY scripts/cco_telegram.py /app/scripts/
COPY scripts/cco_reddit.py /app/scripts/
COPY scripts/cco_x.py /app/scripts/
COPY scripts/cco_newsletter.py /app/scripts/
COPY scripts/cco_entrypoint.py /app/scripts/
COPY scripts/cdo_audit.py /app/scripts/
COPY scripts/cdo_entrypoint.py /app/scripts/

# Default entrypoint (overridden per Cloud Run Job via --command/--args)
ENTRYPOINT ["python3", "/app/scripts/cco_entrypoint.py"]
