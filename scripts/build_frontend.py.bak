   525|<!-- ═══ DATA INJECTION ═══ -->
   526|<script>
   527|const NARRATIVES = __NARRATIVES_JSON__;
   528|const STORIES = __STORIES_JSON__;
   529|const CAPITAL_FLOWS = __CAPITAL_JSON__;
   530|const CROSS_ASSET = __CROSS_ASSET_JSON__;
   531|const REGIME = __REGIME_JSON__;
   532|const REGIME_DRIVERS = __REGIME_DRIVERS_JSON__;
   533|const BUILD_TIME = "__BUILD_TIME__";
   534|</script>
   535|
   536|<!-- ═══ RENDER LOGIC ═══ -->
   537|<script>
   538|(function() {
   539|  // ── TAB SWITCHING ──
   540|  window.switchTab = function(name) {
   541|    document.querySelectorAll('.tab-content').forEach(function(v){v.classList.remove('active')});
   542|    document.querySelectorAll('.tab-btn').forEach(function(b){b.classList.remove('active')});
   543|    var view = document.getElementById('view-' + name);
   544|    if (view) view.classList.add('active');
   545|    var btns = document.querySelectorAll('[data-tab="' + name + '"]');
   546|    btns.forEach(function(b){b.classList.add('active')});
   547|    if (name !== 'stream') document.getElementById('mobile-menu').classList.add('hidden');
   548|    window.location.hash = name;
   549|    // Update mobile bottom nav
   550|    document.querySelectorAll('#view-stream ~ nav button').forEach(function(b,i){
   551|      var tabs = ['stream','capital','contradictions','about'];
   552|      if (tabs[i] === name) { b.classList.add('text-gold'); b.querySelector('span').style.fontVariationSettings = "'FILL' 1"; }
   553|      else { b.classList.remove('text-gold'); }
   554|    });
   555|  };
   556|
   557|  // ── TAB CLICK HANDLER ──
   558|  document.getElementById('tab-nav').addEventListener('click', function(e) {
   559|    var btn = e.target.closest('[data-tab]');
   560|    if (!btn) return;
   561|    switchTab(btn.getAttribute('data-tab'));
   562|  });
   563|
   564|  // ── HASH ROUTING ──
   565|  var hash = window.location.hash.replace('#','');
   566|  if (hash && ['stream','capital','contradictions','about'].indexOf(hash) >= 0) switchTab(hash);
   567|
   568|  // ── RENDER SIDEBAR ──
   569|  var sidebarNav = document.getElementById('sidebar-nav');
   570|  var sidebarVuln = document.getElementById('sidebar-vuln');
   571|  if (sidebarNav && NARRATIVES.length) {
   572|    sidebarNav.innerHTML = NARRATIVES.map(function(n, i) {
   573|      var active = i === 0 ? ' text-gold-accessible border-b-2 border-gold-accessible' : ' text-on-primary/70 hover:text-gold-accessible';
   574|      return '<a href="#" class="flex items-center gap-3 px-3 py-2 font-metadata-sm text-metadata-sm uppercase tracking-wider' + active + '">' +
   575|        '<span class="text-lg font-headline-md">' + n.ticker + '</span>' +
   576|        '<span>' + n.title + '</span>' +
   577|        '<span class="ml-auto text-gold-accessible text-xs">' + (n.capital_b >= 1 ? n.capital_b.toFixed(1)+'B' : (n.capital_b*1000).toFixed(0)+'M') + '</span>' +
   578|        '</a>';
   579|    }).join('');
   580|    var sorted = NARRATIVES.slice().sort(function(a,b){return b.gap - a.gap;}).slice(0,4);
   581|    sidebarVuln.innerHTML = sorted.map(function(n){
   582|      var pct = Math.min(n.gap, 100);
   583|      return '<div><div class="flex justify-between text-on-primary mb-1"><span class="font-metadata-sm text-xs">'+n.title+'</span><span class="text-gold text-xs">'+n.gap.toFixed(0)+'</span></div>' +
   584|        '<div class="meter-container"><div class="meter-fill-neg" style="width:'+pct+'%;"></div></div></div>';
   585|    }).join('');
   586|  }
   587|
   588|  // ── MOBILE NAV ──
   589|  var mobileNav = document.getElementById('mobile-nav');
   590|  if (mobileNav && NARRATIVES.length) {
   591|    mobileNav.innerHTML = NARRATIVES.map(function(n){
   592|      return '<a href="#" class="flex items-center gap-3 px-4 py-3 text-on-primary hover:bg-primary-container font-metadata-sm text-metadata-sm uppercase tracking-wider" onclick="document.getElementById(\'mobile-menu\').classList.add(\'hidden\')">' +
   593|        '<span class="material-symbols-outlined text-gold">'+n.icon+'</span>' +
   594|        '<span>'+n.title+'</span>' +
   595|        '<span class="ml-auto text-gold-accessible text-xs">'+n.count+'</span></a>';
   596|    }).join('');
   597|  }
   598|
   599|  // ── VIEW 1: STREAM CARDS ──
   600|  var cardsEl = document.getElementById('story-cards');
   601|  if (cardsEl && STORIES.length) {
   602|    cardsEl.innerHTML = STORIES.map(function(s){
   603|      var gap = s.contradiction_gap || 0;
   604|      var tier = s.tier || '';
   605|      var isDiv = gap >= 40;
   606|      var tagClass = isDiv ? 'bg-error-container/20 text-error' : 'bg-surface-container text-on-surface-variant';
   607|      var label = isDiv ? 'DIVERGENT' : 'CONVERGENT';
   608|      var gapPct = Math.min(gap, 100);
   609|      var capVol = s.capital_volume_usd || 0;
   610|      var capB = capVol / 1e9;
   611|      var capStr = capB >= 1 ? capB.toFixed(1)+'B' : (capB*1000).toFixed(0)+'M';
   612|      var timeAgo = '';
   613|      if (s.generated_at) {
   614|        var d = new Date(s.generated_at);
   615|        var h = Math.floor((new Date() - d) / 3600000);
   616|        timeAgo = h <= 0 ? 'Just now' : h + 'H AGO';
   617|      }
   618|      return '<article data-story-id="' + (s.story_id || '') + '" data-source-feed="' + (s.feed_source || '') + '" data-tier="(s.tier || '')" class="py-stack-space-md border-b border-gold/20 border-l-2 border-gold/30">' +
   619|        '<div class="pl-stack-space-md">' +
   620|        '<div class="flex justify-between items-start mb-2 flex-wrap gap-2">' +
   621|          '<div class="flex items-center gap-2">' +
   622|            '<span class="font-metadata-sm text-metadata-sm text-on-surface-variant uppercase">'+(s._container_title||'')+'</span>' +
   623|            '<span class="font-label-xs text-label-xs text-gold-accessible">'+timeAgo+'</span>' +
   624|            (s.feed_source ? '<span class="font-label-xs text-label-xs text-on-surface-variant">via '+(s.feed_source||'')+'</span>' : '') +
   625|          '</div>' +
   626|          '<span class="px-2 py-0.5 border border-outline-variant font-label-xs text-label-xs uppercase '+tagClass+'">'+label+' · '+gap.toFixed(0)+'/100</span>' +
   627|        '</div>' +
   628|        '<h3 class="font-headline-md text-headline-md text-on-surface leading-tight mb-2">'+(s.headline||'Untitled')+'</h3>' +
   629|        '<div class="mt-stack-space-sm flex items-center gap-3">' +
   630|          '<span class="font-metadata-sm text-metadata-sm text-on-surface-variant uppercase">Capital</span>' +
   631|          '<div class="flex-grow h-[3px] bg-surface-variant relative"><div class="absolute left-0 top-0 h-full bg-gold" style="width:'+gapPct+'%;"></div></div>' +
   632|          '<span class="font-metadata-sm text-metadata-sm text-on-surface">'+capStr+'</span>' +
   633|        '</div>' +
   634|        '<div class="mt-2 flex gap-2 flex-wrap">' +
   635|          (tier?'<span class="text-xs text-crimson uppercase tracking-wider border border-error/30 px-1.5 py-0.5">'+tier+'</span>':'') +
   636|          '<span class="text-xs text-on-surface-variant uppercase tracking-wider">Gap: '+gap.toFixed(0)+'</span>' +
   637|        '</div>' +
   638|        '<details class="mt-2">' +
   639|          '<summary class="font-metadata-sm text-metadata-sm text-gold-accessible uppercase tracking-wider flex items-center gap-1">' +
   640|            '<span class="material-symbols-outlined expand-icon" style="font-size:18px;">expand_more</span> Read Dispatch' +
   641|          '</summary>' +
   642|          '<div class="details-content mt-stack-space-sm grid grid-cols-1 md:grid-cols-2 gap-stack-space-sm">' +
   643|            '<div class="bg-surface-container-high p-stack-space-sm border-l border-outline-variant">' +
   644|              '<h4 class="font-metadata-sm text-metadata-sm text-on-surface-variant uppercase mb-1">Media Consensus</h4>' +
   645|              '<p class="font-body-md text-body-md text-on-surface-variant">'+(s.they_say||'No data.')+'</p>' +
   646|            '</div>' +
   647|            '<div class="bg-gold/5 p-stack-space-sm border-l border-gold">' +
   648|              '<h4 class="font-metadata-sm text-metadata-sm text-gold-dim uppercase mb-1">Market Reality</h4>' +
   649|              '<p class="font-body-md text-body-md text-on-surface">'+(s.reality||'No data.')+'</p>' +
   650|            '</div>' +
   651|          '</div>' +
   652|        '</details>' +
   653|        '</div></article>';
   654|        '</div></div></article>';
   655|    }).join('');
   656|
   657|    // Post-render source attribution injection
   658|    injectSourceAttribution();
   659|  }
   660|
   661|  function injectSourceAttribution() {
   662|    var articles = document.querySelectorAll('article[data-story-id]');
   663|    for (var i = 0; i < articles.length; i++) {
   664|      var card = articles[i];
   665|      if (card.querySelector('.source-attribution-footer')) continue;
   666|      var sourceData = card.getAttribute('data-source-feed');
   667|      if (!sourceData || sourceData.trim() === '') continue;
   668|      var footer = document.createElement('div');
   669|      footer.className = 'source-attribution-footer mt-4 pt-2 border-t border-gray-100 flex items-center justify-between text-xs text-gray-400 font-mono tracking-tight';
   670|      footer.innerHTML = '<div class="flex items-center gap-1.5"><span class="material-symbols-outlined text-[12px] text-gray-300">database</span><span>FEED_SOURCE: ' + sourceData.toUpperCase().trim() + '</span></div><div class="text-[10px] bg-gray-50 px-1.5 py-0.5 rounded border border-gray-200 font-sans">VERIFIED_DISPATCH</div>';
   671|      card.appendChild(footer);
   672|    }
   673|  }
   674|
   675|  // ── VIEW 2: CAPITAL FLOW TABLE ──
   676|  var capBody = document.getElementById('capital-body');
   677|  if (capBody && CAPITAL_FLOWS.length) {
   678|    capBody.innerHTML = CAPITAL_FLOWS.map(function(cf){
   679|      var isDisc = cf.discrepancies > 3;
   680|      var rowClass = isDisc ? 'discrepancy-row' : '';
   681|      var netSign = cf.net_b >= 0 ? '+' : '';
   682|      var netClass = cf.net_b >= 0 ? 'text-gold-dim' : 'text-error';
   683|      return '<tr class="border-b border-surface-variant font-body-md text-body-md '+rowClass+'">' +
   684|        '<td class="py-2 pr-4 font-metadata-sm text-metadata-sm">'+cf.narrative+'</td>' +
   685|        '<td class="py-2 pr-4 font-headline-md text-gold-dim">'+cf.ticker+'</td>' +
   686|        '<td class="py-2 pr-4 text-right">'+cf.inflow_b.toFixed(1)+'B</td>' +
   687|        '<td class="py-2 pr-4 text-right">'+cf.outflow_b.toFixed(1)+'B</td>' +
   688|        '<td class="py-2 pr-4 text-right '+netClass+'">'+netSign+cf.net_b.toFixed(1)+'B</td>' +
   689|        '<td class="py-2 pr-4 text-right">'+cf.total_b.toFixed(1)+'B</td>' +
   690|        '<td class="py-2 pr-4 text-right">'+cf.stories+'</td>' +
   691|        '<td class="py-2 pr-4 text-center">'+(cf.discrepancies > 3 ? '<span class="material-symbols-outlined text-error text-sm">warning</span> '+cf.discrepancies : '<span class="material-symbols-outlined text-outline text-sm">check_circle</span>')+'</td>' +
   692|        '<td class="py-2 text-right font-metadata-sm">'+cf.gap.toFixed(0)+'</td>' +
   693|        '</tr>';
   694|    }).join('');
   695|  }
   696|
   697|  // Cross-asset grid
   698|  var caGrid = document.getElementById('cross-asset-grid');
   699|  if (caGrid && Object.keys(CROSS_ASSET).length) {
   700|    caGrid.innerHTML = Object.keys(CROSS_ASSET).map(function(k){
   701|      return '<div class="bg-surface-container p-stack-space-sm border border-outline-variant text-center">' +
   702|        '<span class="font-label-xs text-label-xs uppercase text-on-surface-variant block">'+k.toUpperCase()+'</span>' +
   703|        '<span class="font-headline-md text-headline-md text-on-surface mt-1">'+CROSS_ASSET[k]+'</span>' +
   704|        '</div>';
   705|    }).join('');
   706|  }
   707|
   708|  // Regime drivers
   709|  var rdEl = document.getElementById('regime-drivers');
   710|  if (rdEl && REGIME_DRIVERS.length) {
   711|    rdEl.innerHTML = REGIME_DRIVERS.map(function(d){
   712|      return '<span class="border border-outline px-3 py-1 font-label-xs text-label-xs uppercase">'+d+'</span>';
   713|    }).join('');
   714|  }
   715|
   716|  // ── VIEW 3: CONTRADICTION MATRIX (reads from STORIES) ──
   717|  function renderMatrix(filter, sort) {
   718|    // Build divergence dataset from STORIES (gap >= 40 only)
   719|    var data = [];
   720|    for (var i = 0; i < STORIES.length; i++) {
   721|      var s = STORIES[i];
   722|      var gap = s.contradiction_gap || 0;
   723|      if (gap < 40) continue;
   724|      var capB = (s.capital_volume_usd || 0) / 1e9;
   725|      var ago = '';
   726|      if (s.generated_at) {
   727|        var dd = new Date(s.generated_at);
   728|        var hh = Math.floor((new Date() - dd) / 3600000);
   729|        ago = hh <= 0 ? 'Just now' : hh + 'H AGO';
   730|      }
   731|      data.push({
   732|        id: s.story_id || 0,
   733|        headline: s.headline || 'Untitled',
   734|        container: s._container_title || '',
   735|        container_id: s._container_id || '',
   736|        gap: gap,
   737|        capital_b: capB,
   738|        tier: s.tier || '',
   739|        time_ago: ago,
   740|        they_say: (s.they_say || '').substring(0, 200),
   741|        reality: (s.reality || '').substring(0, 200)
   742|      });
   743|    }
   744|    if (filter !== 'all') data = data.filter(function(c){return c.container_id === filter;});
   745|    if (sort === 'gap') data.sort(function(a,b){return b.gap - a.gap;});
   746|    else if (sort === 'capital') data.sort(function(a,b){return b.capital_b - a.capital_b;});
   747|    else data.sort(function(a,b){return b.id - a.id;});
   748|    var matrixBody = document.getElementById('matrix-body');
   749|    if (!matrixBody) return;
   750|    matrixBody.innerHTML = data.slice(0, 100).map(function(c){
   751|      var tierInfo = c.gap >= 65 ? {label:'BREAKING', border:'border-l-2 border-crimson', text:'text-crimson', badge:'bg-crimson/10 text-crimson'} :
   752|                     c.gap >= 40 ? {label:'ACTIVE', border:'border-l-2 border-gold-accessible', text:'text-gold-accessible', badge:'bg-gold-accessible/10 text-gold-accessible'} :
   753|                                   {label:'SETTLING', border:'border-l-2 border-gray-300', text:'text-gold-dim', badge:'bg-slate-100 text-slate-600'};
   754|      return '<details class="py-stack-space-sm border-b border-gold/20 '+tierInfo.border+'">' +
   755|        '<summary class="pl-stack-space-sm">' +
   756|        '<div class="flex justify-between items-start flex-wrap gap-2">' +
   757|          '<div><span class="font-label-xs text-label-xs text-on-surface-variant uppercase">'+c.container+'</span>' +
   758|          '<span class="font-label-xs text-label-xs text-on-surface-variant ml-2">'+c.time_ago+'</span>' +
   759|          '<span class="material-symbols-outlined expand-icon text-on-surface-variant align-middle ml-1" style="font-size:18px;">expand_more</span></div>' +
   760|          '<span class="font-metadata-sm text-metadata-sm '+tierInfo.text+'">Gap: '+c.gap.toFixed(0)+' | '+c.capital_b.toFixed(1)+'B</span>' +
   761|        '</div>' +
   762|        '<p class="font-body-md text-body-md text-on-surface mt-1">'+c.headline+'</p>' +
   763|        '<div class="flex items-center gap-2 mt-2"><span class="text-xs uppercase tracking-wider '+tierInfo.text+'">'+tierInfo.label+'</span>' +
   764|        '<span class="text-xs uppercase px-1 py-0.5 '+tierInfo.badge+'">GAP: '+c.gap.toFixed(0)+'</span>' +
   765|        '</div></summary>' +
   766|        '<div class="details-content mt-2 pl-stack-space-sm grid grid-cols-1 md:grid-cols-2 gap-stack-space-sm">' +
   767|          '<div class="bg-surface-container-high p-stack-space-sm border-l border-outline-variant">' +
   768|            '<h4 class="font-metadata-sm text-metadata-sm text-on-surface-variant uppercase mb-1">Media Consensus</h4>' +
   769|            '<p class="font-body-md text-body-md text-on-surface-variant">'+c.they_say+'</p>' +
   770|          '</div>' +
   771|          '<div class="bg-gold/5 p-stack-space-sm border-l border-gold">' +
   772|            '<h4 class="font-metadata-sm text-metadata-sm text-gold-dim uppercase mb-1">Market Reality</h4>' +
   773|            '<p class="font-body-md text-body-md text-on-surface">'+c.reality+'</p>' +
   774|          '</div>' +
   775|        '</div>' +
   776|        '</details>';
   777|    }).join('');
   778|  }
   779|
   780|  // Filter dropdown
   781|  var filterEl = document.getElementById('matrix-filter');
   782|  if (filterEl) {
   783|    filterEl.innerHTML = '<option value="all">All Narratives</option>' +
   784|      NARRATIVES.map(function(n){return '<option value="'+n.id+'">'+n.title+'</option>';}).join('');
   785|    filterEl.addEventListener('change', function(){
   786|      renderMatrix(this.value, document.getElementById('matrix-sort').value);
   787|    });
   788|  }
   789|  var sortEl = document.getElementById('matrix-sort');
   790|  if (sortEl) {
   791|    sortEl.addEventListener('change', function(){
   792|      renderMatrix(document.getElementById('matrix-filter').value, this.value);
   793|    });
   794|  }
   795|  renderMatrix('all', 'gap');
   796|
   797|  // ── C1: CLIENT-SIDE FILTERING ──
   798|  var activeFilters = {tier: 'all', origin: 'all'};
   799|
   800|  (function buildOriginPills() {
   801|    var seen = {};
   802|    var pills = '';
   803|    for (var i = 0; i < STORIES.length; i++) {
   804|      var fs = STORIES[i].feed_source;
   805|      if (fs && !seen[fs]) { seen[fs] = true; pills += '<button class="filter-pill px-2 py-1 font-label-xs text-label-xs uppercase border border-outline text-on-surface-variant hover:border-gold-accessible hover:text-gold-accessible" data-filter="origin-'+fs.replace(/ /g,'_')+'">'+fs+'</button>'; }
   806|    }
   807|    var op = document.getElementById('origin-pills');
   808|    if (op) op.innerHTML = pills;
   809|  })();
   810|
   811|  function applyFilters() {
   812|    var cards = document.querySelectorAll('#story-cards article[data-story-id]');
   813|    for (var i = 0; i < cards.length; i++) {
   814|      var card = cards[i];
   815|      var tier = card.getAttribute('data-tier') || '';
   816|      var origin = card.getAttribute('data-source-feed') || '';
   817|      var show = true;
   818|      if (activeFilters.tier !== 'all' && tier !== activeFilters.tier) show = false;
   819|      if (activeFilters.origin !== 'all' && origin.toUpperCase() !== activeFilters.origin.toUpperCase()) show = false;
   820|      card.style.display = show ? '' : 'none';
   821|    }
   822|    if (typeof injectSourceAttribution === 'function') injectSourceAttribution();
   823|  }
   824|
   825|  var filterPills = document.querySelectorAll('#filter-bar .filter-pill');
   826|  for (var i = 0; i < filterPills.length; i++) {
   827|    filterPills[i].addEventListener('click', function(){
   828|      var f = this.getAttribute('data-filter');
   829|      var siblings = this.parentElement.querySelectorAll('.filter-pill');
   830|      for (var j = 0; j < siblings.length; j++) siblings[j].classList.remove('text-gold-accessible', 'border-gold-accessible');
   831|      this.classList.add('text-gold-accessible', 'border-gold-accessible');
   832|      if (f === 'all') { activeFilters.tier = 'all'; activeFilters.origin = 'all'; }
   833|      else if (f.indexOf('tier-') === 0) { activeFilters.tier = f.substring(5); activeFilters.origin = 'all'; }
   834|      else if (f.indexOf('origin-') === 0) { activeFilters.origin = f.substring(7).replace(/_/g,' '); activeFilters.tier = 'all'; }
   835|      if (f === 'all' || f.indexOf('tier-') === 0) {
   836|        var allBtn = document.querySelector('#filter-bar .filter-pill[data-filter="all"]');
   837|        if (f === 'all' && allBtn) { allBtn.classList.add('text-gold-accessible','border-gold-accessible'); }
   838|        else if (allBtn) { allBtn.classList.remove('text-gold-accessible','border-gold-accessible'); }
   839|      }
   840|      applyFilters();
   841|    });
   842|  }
   843|  // ── VIEW 4: ABOUT / PHASE TABLE ──
   844|  var phaseBody = document.getElementById('phase-body');
   845|  if (phaseBody && NARRATIVES.length) {
   846|    phaseBody.innerHTML = NARRATIVES.map(function(n){
   847|      return '<tr class="border-b border-surface-variant font-body-md text-body-md">' +
   848|        '<td class="py-2 pr-4 font-metadata-sm text-metadata-sm">'+n.title+'</td>' +
   849|        '<td class="py-2 pr-4 text-gold-dim font-headline-md">'+n.ticker+'</td>' +
   850|        '<td class="py-2 pr-4 text-right">'+n.gap.toFixed(0)+'</td>' +
   851|        '<td class="py-2 pr-4"><span class="px-2 py-0.5 font-label-xs text-label-xs uppercase '+(n.phase==='VIRAL EXPANSION'?'bg-error-container/20 text-error':'bg-surface-container text-on-surface-variant')+'">'+n.phase+'</span></td>' +
   852|        '<td class="py-2"><span class="font-metadata-sm text-metadata-sm text-crimson">'+n.threshold_val+'</span><br><span class="text-xs text-on-surface-variant">'+n.threshold_desc+'</span></td>' +
   853|        '</tr>';
   854|    }).join('');
   855|  }
   856|
   857|})();
   858|</script>
   859|
   860|</body>
   861|</html>"""
   862|
