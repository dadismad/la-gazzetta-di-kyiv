   345|  <!-- ═══ VIEW 1: THE STREAM ═══ -->
   346|  <main class="tab-content active flex-1 max-w-4xl mx-auto w-full px-margin-horizontal py-stack-space-lg" id="view-stream">
   347|    <div class="flex justify-between items-end mb-stack-space-md pb-stack-space-sm border-b-2 border-gold">
   348|      <div>
   349|        <h2 class="font-headline-lg text-headline-lg text-on-surface">The Stream</h2>
   350|        <p class="font-metadata-sm text-metadata-sm text-on-surface-variant uppercase tracking-wider">__STORY_COUNT__ stories · __REGIME_STR__</p>
   351|      </div>
   352|      <span class="hidden md:inline border border-outline px-3 py-1 font-label-xs text-label-xs uppercase">Live · __REGIME_STR__</span>
   353|    </div>
   354|    <!-- C1: Client-side filter bar -->
   355|    <div class="flex flex-wrap gap-2 mb-stack-space-sm" id="filter-bar">
   356|      <span class="font-metadata-sm text-metadata-sm text-on-surface-variant uppercase self-center mr-1">Filter:</span>
   357|      <button class="filter-pill px-2 py-1 font-label-xs text-label-xs uppercase border border-outline text-on-surface-variant hover:border-gold-accessible hover:text-gold-accessible active" data-filter="all">All</button>
   358|      <span class="self-center text-outline mx-1">|</span>
   359|      <span class="font-metadata-sm text-metadata-sm text-on-surface-variant uppercase self-center">Tier:</span>
   360|      <button class="filter-pill px-2 py-1 font-label-xs text-label-xs uppercase border border-outline text-on-surface-variant hover:border-gold-accessible hover:text-gold-accessible" data-filter="tier-BREAKING">BREAKING</button>
   361|      <button class="filter-pill px-2 py-1 font-label-xs text-label-xs uppercase border border-outline text-on-surface-variant hover:border-gold-accessible hover:text-gold-accessible" data-filter="tier-ACTIVE">ACTIVE</button>
   362|      <button class="filter-pill px-2 py-1 font-label-xs text-label-xs uppercase border border-outline text-on-surface-variant hover:border-gold-accessible hover:text-gold-accessible" data-filter="tier-SETTLING">SETTLING</button>
   363|      <span class="self-center text-outline mx-1">|</span>
   364|      <span class="font-metadata-sm text-metadata-sm text-on-surface-variant uppercase self-center">Origin:</span>
   365|      <span id="origin-pills" class="flex flex-wrap gap-1"></span>
   366|    </div>
   367|    <div class="flex flex-col gap-0" id="story-cards"></div>
   368|  </main>
   369|
   370|  <!-- ═══ VIEW 2: CAPITAL FLOWS ═══ -->
   371|  <main class="tab-content flex-1 max-w-4xl mx-auto w-full px-margin-horizontal py-stack-space-lg" id="view-capital">
   372|    <div class="flex justify-between items-end mb-stack-space-md pb-stack-space-sm border-b-2 border-gold">
   373|      <div>
