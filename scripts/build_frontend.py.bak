     1|#!/usr/bin/env python3
     2|"""
     3|build_frontend.py -- Gazzetta di Kyiv Multi-View Dashboard Compiler
     4|Generates a single responsive SPA with 4 analytical views:
     5|  1. The Stream — real-time story feed
     6|  2. Capital Flows — macro ledger + discrepancy markers
     7|  3. Contradictions — sortable matrix + vulnerability map
     8|  4. About — epistemological framing + narrative lifecycle
     9|
    10|Design: Stitch DESIGN.md (mobile) + Banani desktop sidebar
    11|0px radius, no shadows, gold structural rules, Playfair+Inter.
    12|"""
    13|
    14|import json, sys, os
    15|from pathlib import Path
    16|from datetime import datetime, timezone
    17|
    18|PROJECT = Path(os.environ.get("GAZZETTA_HOME", "/opt/gazzetta-di-kyiv"))
    19|DATA = PROJECT / "data"
    20|PUBLIC = PROJECT / "public"
    21|PUBLIC_DATA = PUBLIC / "data"
    22|
    23|TICKER_MAP = {
    24|    "dollar_decline": "DXY", "energy_sovereignty": "Brent",
    25|    "deglobalization": "XLI", "china_ascent": "FXI",
    26|    "space_economy": "ROKT", "gene_editing": "ARKG",
    27|    "tech_convergence": "QQQ", "wealthy_sports": "BATRK"
    28|}
    29|
    30|PILL_ORDER = [
    31|    "dollar_decline", "energy_sovereignty", "deglobalization",
    32|    "china_ascent", "space_economy", "gene_editing",
    33|    "tech_convergence", "wealthy_sports"
    34|]
    35|
    36|ICON_MAP = {
    37|    "dollar_decline": "trending_down", "energy_sovereignty": "bolt",
    38|    "deglobalization": "public", "china_ascent": "language",
    39|    "space_economy": "rocket_launch", "gene_editing": "biotech",
    40|    "tech_convergence": "memory", "wealthy_sports": "sports_soccer"
    41|}
    42|
    43|def load_json(path):
    44|    with open(path) as f:
    45|        return json.load(f)
    46|
    47|def fmt_b(n):
    48|    if n >= 1: return f"{n:.1f}B"
    49|    m = n * 1000
    50|    if m >= 1: return f"{m:.0f}M"
    51|    return f"{m:.1f}M"
    52|
    53|def fmt_time_ago(ts_str):
    54|    if not ts_str: return ""
    55|    try:
    56|        d = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
    57|        now = datetime.now(timezone.utc)
    58|        hours = (now - d).total_seconds() / 3600
    59|        if hours < 1: return "Just now"
    60|        return f"{int(hours)}H AGO"
    61|    except:
    62|        return ""
    63|
    64|def narrative_phase(gap, count):
    65|    """Heuristic narrative lifecycle phase."""
    66|    if count < 3: return "EMERGENT", "New signal — limited data"
    67|    if gap >= 70: return "VIRAL EXPANSION", "Wide gap between narrative and reality"
    68|    if gap >= 40: return "CONSENSUS SATURATION", "Narrative widely accepted, friction building"
    69|    return "MATURE/STABLE", "Narrative and reality aligned"
    70|
    71|def invalidation_threshold(nid, ticker):
    72|    """Return price-level invalidation triggers per narrative."""
    73|    thresholds = {
    74|        "dollar_decline": ("DXY > 106", "USD strengthening reverses thesis"),
    75|        "energy_sovereignty": ("Brent < $65", "Energy independence narrative breaks"),
    76|        "deglobalization": ("XLI +8% MoM", "Industrial re-globalization invalidates"),
    77|        "china_ascent": ("FXI -15% quarterly", "Capital flight contradicts ascent"),
    78|        "space_economy": ("ROKT -25%", "Space investment thesis invalidated"),
    79|        "gene_editing": ("ARKG -30%", "Biotech funding freeze contradicts"),
    80|        "tech_convergence": ("QQQ -20%", "Tech selloff invalidates convergence"),
    81|        "wealthy_sports": ("BATRK -25%", "Sports asset bubble pops"),
    82|    }
    83|    return thresholds.get(nid, ("N/A", "No threshold defined"))
    84|
    85|def build():
    86|    print("[build_frontend] loading data...")
    87|    stories_raw = load_json(DATA / "stories.json")
    88|
    89|    # Try flows.json for cross-asset data
    90|    flows_raw = {}
    91|    flows_path = PUBLIC_DATA / "flows.json"
    92|    if flows_path.exists():
    93|        flows_raw = load_json(flows_path)
    94|
    95|    # Normalize stories
    96|    all_stories = []
    97|    containers = stories_raw.get("containers", {})
    98|    for cid, cdata in containers.items():
    99|        for s in cdata.get("stories", []):
   100|            s["_container_id"] = cid
   101|            s["_container_title"] = cdata.get("title", cid)
   102|            all_stories.append(s)
   103|
   104|    all_stories.sort(key=lambda s: s.get("generated_at", ""), reverse=True)
   105|
   106|    # Compute narrative summaries
   107|    narratives = []
   108|    for cid in PILL_ORDER:
   109|        cstories = [s for s in all_stories if s.get("_container_id") == cid]
   110|        caps = [s.get("capital_volume_usd", 0) or 0 for s in cstories]
   111|        gaps = [s.get("contradiction_gap", 0) or 0 for s in cstories]
   112|        total_cap = sum(caps) / 1e9
   113|        avg_gap = sum(gaps) / len(gaps) if gaps else 0
   114|        directions = {"inflow": 0, "outflow": 0, "neutral": 0}
   115|        for s in cstories:
   116|            cf = s.get("capital_flow") or {}
   117|            d = (cf.get("direction") or "neutral").lower()
   118|            directions[d] = directions.get(d, 0) + 1
   119|        phase, phase_desc = narrative_phase(avg_gap, len(cstories))
   120|        threshold_val, threshold_desc = invalidation_threshold(cid, TICKER_MAP.get(cid, ""))
   121|        cdata = containers.get(cid, {})
   122|        narratives.append({
   123|            "id": cid,
   124|            "title": cdata.get("title", cid.replace("_", " ").title()),
   125|            "ticker": TICKER_MAP.get(cid, "N/A"),
   126|            "capital_b": total_cap,
   127|            "count": len(cstories),
   128|            "gap": avg_gap,
   129|            "directions": directions,
   130|            "phase": phase,
   131|            "phase_desc": phase_desc,
   132|            "threshold_val": threshold_val,
   133|            "threshold_desc": threshold_desc,
   134|            "icon": ICON_MAP.get(cid, "public"),
   135|        })
   136|
   137|    # Capital flows — compute discrepancies
   138|    discrepancies = [s for s in all_stories if (s.get("contradiction_gap") or 0) >= 40]
   139|    capital_flows = []
   140|    for n in narratives:
   141|        cap_stories = [s for s in all_stories if s.get("_container_id") == n["id"]]
   142|        inflow_total = sum((s.get("capital_volume_usd") or 0) / 1e9 for s in cap_stories
   143|                          if (s.get("capital_flow") or {}).get("direction") == "inflow")
   144|        outflow_total = sum((s.get("capital_volume_usd") or 0) / 1e9 for s in cap_stories
   145|                           if (s.get("capital_flow") or {}).get("direction") == "outflow")
   146|        disc_count = sum(1 for s in cap_stories if (s.get("contradiction_gap") or 0) >= 40)
   147|        capital_flows.append({
   148|            "narrative": n["title"],
   149|            "ticker": n["ticker"],
   150|            "inflow_b": inflow_total,
   151|            "outflow_b": outflow_total,
   152|            "net_b": inflow_total - outflow_total,
   153|            "total_b": n["capital_b"],
   154|            "stories": n["count"],
   155|            "discrepancies": disc_count,
   156|            "gap": n["gap"],
   157|        })
   158|
   159|    # Contradictions now computed client-side from STORIES (see renderMatrix)
   160|
   161|    # Cross-asset data
   162|    cross_asset = flows_raw.get("cross_asset", {})
   163|    regime = flows_raw.get("regime", stories_raw.get("regime", "risk-on"))
   164|    regime_drivers = flows_raw.get("regime_drivers", [])
   165|
   166|    # Strip dead fields from stories (never read by frontend)
   167|    dead_fields = {"thesis", "multi_persona", "confidence_pct", "contradiction_score", "sector", "source_name", "pillar", "tags"}
   168|    stories_slim = []
   169|    for s in all_stories[:200]:
   170|        stories_slim.append({k: v for k, v in s.items() if k not in dead_fields})
   171|
   172|    # Serialize
   173|    stories_json = json.dumps(stories_slim, ensure_ascii=False)
   174|    narratives_json = json.dumps(narratives, ensure_ascii=False)
   175|    capital_json = json.dumps(capital_flows, ensure_ascii=False)
   176|    cross_asset_json = json.dumps(cross_asset, ensure_ascii=False)
   177|    regime_json = json.dumps(regime, ensure_ascii=False)
   178|    regime_drivers_json = json.dumps(regime_drivers, ensure_ascii=False)
   179|    build_time = datetime.now(timezone.utc).isoformat()
   180|    disc_count = len(discrepancies)
   181|    sync_status = "Active" if disc_count < 50 else "Warning"
   182|
   183|    print(f"[build_frontend] {len(all_stories)} stories, {disc_count} discrepancies, regime={regime}")
   184|
   185|    html = _TEMPLATE
   186|    html = html.replace("__STORIES_JSON__", stories_json)
   187|    html = html.replace("__NARRATIVES_JSON__", narratives_json)
   188|    html = html.replace("__CAPITAL_JSON__", capital_json)
   189|    html = html.replace("__CONTRADICTIONS_JSON__", "[]")
   190|    html = html.replace("__CROSS_ASSET_JSON__", cross_asset_json)
   191|    html = html.replace("__REGIME_JSON__", regime_json)
   192|    html = html.replace("__REGIME_DRIVERS_JSON__", regime_drivers_json)
   193|    html = html.replace("__REGIME_STR__", str(regime))
   194|    html = html.replace("__BUILD_TIME__", build_time)
   195|    html = html.replace("__STORY_COUNT__", str(len(all_stories)))
   196|    html = html.replace("__DISC_COUNT__", str(disc_count))
   197|    html = html.replace("__SYNC_STATUS__", sync_status)
   198|
   199|    PUBLIC.mkdir(parents=True, exist_ok=True)
   200|    out = PUBLIC / "index.html"
   201|    with open(out, "w") as f:
   202|        f.write(html)
   203|
   204|    print(f"[build_frontend] wrote {out} ({len(html)} bytes)")
   205|    return True
   206|
   207|
   208|_TEMPLATE = r"""<!DOCTYPE html>
   209|<html class="light" lang="en">
   210|<head>
   211|<meta charset="utf-8"/>
   212|<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
   213|<title>La Gazzetta di Kyiv — Geopolitical Intelligence</title>
   214|<meta name="description" content="Institutional-grade narrative intelligence. Tracking the gap between media consensus and capital flows."/>
   215|<link rel="preconnect" href="https://fonts.googleapis.com">
   216|<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   217|<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"/>
   218|<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
   219|<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
   220|<script>
   221|tailwind.config = {
   222|  darkMode: "class",
   223|  theme: {
   224|    extend: {
   225|      colors: {
   226|        "surface": "#FAF9F6","surface-dim": "#DBDAD7","surface-bright": "#FAF9F6",
   227|        "surface-container": "#EFEEEB","surface-container-high": "#E9E8E5",
   228|        "surface-container-highest": "#E3E2E0","on-surface": "#1A1C1A",
   229|        "on-surface-variant": "#444748","inverse-surface": "#2F312F",
   230|        "inverse-on-surface": "#F2F1EE","outline": "#747878",
   231|        "outline-variant": "#C4C7C7","gold": "#D4AF37","gold-dim": "#B8860B","gold-accessible": "#B45309",
   232|        "crimson": "#8B0000","roman-purple": "#66023C","navy": "#1A1F2E",
   233|        "primary": "#000000","on-primary": "#FFFFFF","secondary": "#735C00",
   234|        "on-secondary": "#FFFFFF","secondary-fixed-dim": "#E9C349",
   235|        "error": "#BA1A1A","error-container": "#FFDAD6","on-error-container": "#93000A",
   236|      },
   237|      borderRadius: {"DEFAULT":"0px","lg":"0px","xl":"0px","full":"0px"},
   238|      spacing: {"margin-horizontal":"16px","stack-space-lg":"32px","stack-space-sm":"8px","stack-space-md":"16px","tap-target-min":"48px"},
   239|      fontFamily: {
   240|        "display-xl":["Playfair Display","Georgia","serif"],
   241|        "headline-lg":["Playfair Display","Georgia","serif"],
   242|        "headline-lg-mobile":["Playfair Display","Georgia","serif"],
   243|        "headline-md":["Playfair Display","Georgia","serif"],
   244|        "body-md":["Inter","sans-serif"],"metadata-sm":["Inter","sans-serif"],"label-xs":["Inter","sans-serif"],
   245|      },
   246|      fontSize: {
   247|        "display-xl":["40px",{lineHeight:"48px",letterSpacing:"-0.02em",fontWeight:"700"}],
   248|        "headline-lg":["30px",{lineHeight:"36px",fontWeight:"700"}],
   249|        "headline-lg-mobile":["26px",{lineHeight:"32px",fontWeight:"700"}],
   250|        "headline-md":["22px",{lineHeight:"28px",fontWeight:"600"}],
   251|        "body-md":["16px",{lineHeight:"24px",fontWeight:"400"}],
   252|        "metadata-sm":["13px",{lineHeight:"18px",fontWeight:"500",letterSpacing:"0.04em"}],
   253|        "label-xs":["12px",{lineHeight:"16px",fontWeight:"600",letterSpacing:"0.02em"}],
   254|      },
   255|    }
   256|  }
   257|}
   258|</script>
   259|<style>
   260|  *,*::before,*::after{border-radius:0!important;box-shadow:none!important}
   261|  body{background:#FAF9F6;color:#1A1C1A;min-height:100dvh}
   262|  .hide-scrollbar{-ms-overflow-style:none;scrollbar-width:none}
   263|  .hide-scrollbar::-webkit-scrollbar{display:none}
   264|  .gold-strikethrough{position:relative;display:inline-block}
   265|  .gold-strikethrough::after{content:'';position:absolute;left:0;top:50%;width:100%;height:1px;background:#D4AF37;transform:translateY(-50%);z-index:10}
   266|  .gold-outline{-webkit-text-stroke:1px #D4AF37}
   267|  .meter-container{width:100%;height:4px;background:#E3E2E0;position:relative}
   268|  .meter-fill-pos{position:absolute;left:50%;height:100%;background:#D4AF37}
   269|  .meter-fill-neg{position:absolute;right:50%;height:100%;background:#BA1A1A}
   270|  .discrepancy-row{border-left:4px solid #BA1A1A;padding-left:12px;background:rgba(255,218,214,0.2)}
   271|  .tab-content{display:none}
   272|  .tab-content.active{display:block}
   273|  .tab-btn.active{border-bottom:2px solid #D4AF37;color:#1A1C1A}
   274|  details summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:4px;user-select:none;min-height:48px}
   275|  details summary::-webkit-details-marker{display:none}
   276|  details summary::marker{display:none;content:''}
   277|  details[open] summary .expand-icon{transform:rotate(180deg)}
   278|  details .expand-icon{transition:transform 0.2s;font-size:20px}
   279|  details[open] > .details-content{animation:fadeIn 0.2s ease}
   280|  @keyframes fadeIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
   281|</style>
   282|</head>
