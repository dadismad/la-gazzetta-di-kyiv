{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GazzettaArticleContractV1",
  "type": "object",
  "required": [
    "headline",
    "claim",
    "market_belief",
    "what_is_happening",
    "actors",
    "incentives",
    "second_order_effects",
    "cross_asset_effects",
    "retail_positioning",
    "invalidation_conditions",
    "confidence",
    "narrative_tags"
  ],
  "properties": {
    "headline": {"type": "string", "minLength": 12},
    "claim": {"type": "string", "minLength": 20},
    "market_belief": {"type": "string", "minLength": 20},
    "what_is_happening": {"type": "string", "minLength": 20},
    "actors": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "incentives": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "second_order_effects": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "cross_asset_effects": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "retail_positioning": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {"type": "string", "enum": ["Low", "Medium", "High"]},
    "narrative_tags": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
