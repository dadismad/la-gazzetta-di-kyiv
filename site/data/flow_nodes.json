      "node": "A structural entity that receives, holds, and/or deploys capital. Each node has known sources (inflows) and destinations (outflows).",
      "edge": "A directional capital flow between two nodes. Edge width scales with amount; color indicates direction (green = toward destination, red = away from source).",
      "inflow_velocity": "Rate at which capital enters the node: slow (quarterly), moderate (monthly), fast (weekly), surge (daily/weekly acceleration).",
      "outflow_velocity": "Rate at which capital leaves the node: slow (quarterly), moderate (monthly), fast (weekly), surge (daily/weekly acceleration).",
      "confidence_pct": "Weighted aggregate of data source reliability, reporting lag, and signal strength. Below 60% uses dashed edge rendering.",
      "subtype": "Node specialization within its type category. Examples: central_bank, hedge_fund, stablecoin_issuer, corporate_treasury, trading_platform.",
      "Z.1": "Federal Reserve Financial Accounts of the United States — the official flow-of-funds matrix that decomposes US sectors into inter-sector lending/borrowing."
    }
  }
}
